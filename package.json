{
  "name": "pulsecoach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm test && npm run build",
    "setup:assets": "node -e \"const fs=require('fs');fs.mkdirSync('public/wasm',{recursive:true});fs.cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/wasm',{recursive:true});console.log('Copied MediaPipe wasm to public/wasm')\"",
    "postinstall": "npm run setup:assets"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
